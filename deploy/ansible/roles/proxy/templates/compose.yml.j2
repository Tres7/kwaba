# Generated by Ansible (role proxy): changes go into the inventory, never here
name: proxy

services:
  caddy:
    image: {{ proxy_image }}
    container_name: {{ proxy_conteneur }}
    restart: unless-stopped
    ports: ["80:80", "443:443"]
    volumes:
      # The folder, not the files: Ansible replaces a file with a new one, which a single-file mount would never see
      - ./caddy:/etc/caddy:ro
      - donnees:/data
      - config:/config
    networks: [{{ proxy_reseau }}]
    security_opt: ["no-new-privileges:true"]
    logging:
      driver: local
      options: { max-size: 10m, max-file: "3" }

networks:
  {{ proxy_reseau }}:
    name: {{ proxy_reseau }}
    external: true

volumes:
  donnees:
    name: {{ proxy_volume_donnees }}
{% if proxy_volume_donnees_externe | bool %}
    external: true
{% endif %}
  config:
    name: {{ proxy_volume_config }}
{% if proxy_volume_config_externe | bool %}
    external: true
{% endif %}
