#!/usr/bin/env bash
# Generated by Ansible (role kwaba): the only command of the deploy key (authorized_keys, command=).
# Accepts "deploy <manifest file>" and nothing else. The server fetches main from GitHub itself: the manifest must be on
# main, the images come from it, the VPS configuration (deploy/vps) from main. A stolen key can only deploy what main holds.
set -euo pipefail

racine={{ kwaba_racine | quote }}
depot={{ kwaba_depot | quote }}
service_client={{ kwaba_manifest_client | quote }}
source="${racine}/source"

commande=${SSH_ORIGINAL_COMMAND:-}
if [[ ! $commande =~ ^deploy\ (manifest-[0-9]{4,}-[a-f0-9]{7}\.yaml)$ ]]; then
  echo "Commande refusée (attendu : deploy manifest-0008-2cf8427.yaml)" >&2
  exit 2
fi
manifest=${BASH_REMATCH[1]}

# One deployment at a time, even if two runs reach the server together
exec 9> "${racine}/.deploy.lock"
flock -n 9 || { echo "Un déploiement est déjà en cours" >&2; exit 1; }

# Only deploy/ is checked out (sparse): the latest main, fetched again on every deployment
if [ ! -d "${source}/.git" ]; then
  git clone --quiet --filter=blob:none --no-checkout "$depot" "$source"
  git -C "$source" sparse-checkout set deploy
fi
git -C "$source" fetch --quiet --depth=1 origin main
git -C "$source" checkout --quiet --force --detach FETCH_HEAD
echo "main : $(git -C "$source" rev-parse --short HEAD)"

fichier="${source}/deploy/manifests/${manifest}"
[ -f "$fichier" ] || { echo "Manifest absent de main : ${manifest}" >&2; exit 1; }

# Image of services.<name> (format written by .github/scripts/manifest), pinned by digest in the expected repository:
# under tres7 (personal account, older manifests, kept for rollbacks) or kwa-ba (organisation)
image() {
  awk -v service="  $1:" '$0 == service { dedans = 1; next } dedans && /^    image: / { print $2; exit } /^  [^ ]/ { dedans = 0 }' "$fichier"
}
server_image=$(image server)
client_image=$(image "$service_client")
depot_client=kwaba-client
[ "$service_client" = clientPreprod ] && depot_client=kwaba-client-preprod
[[ $server_image =~ ^ghcr\.io/(tres7|kwa-ba)/kwaba-server@sha256:[a-f0-9]{64}$ ]] \
  || { echo "${manifest} : pas d'image serveur par digest" >&2; exit 1; }
[[ $client_image =~ ^ghcr\.io/(tres7|kwa-ba)/${depot_client}@sha256:[a-f0-9]{64}$ ]] \
  || { echo "${manifest} : pas d'image ${service_client} par digest (manifest antérieur à cet environnement ?)" >&2; exit 1; }

# Same exclusions as the deploy workflow: secrets, backups, logs and deployment state stay on the server.
# --chmod: no group or other write, as set by Ansible, whatever the permissions of the checkout (0775 with umask 002)
rsync -rlpt --delete --chmod=go-w \
  --exclude /env/ --exclude /backups/ --exclude /logs/ --exclude '/.deploy.env*' --exclude /deployments.log \
  --exclude /source/ --exclude /.deploy.lock \
  "${source}/deploy/vps/" "${racine}/"

exec "${racine}/scripts/deploy.sh" "$manifest" "$server_image" "$client_image"
