# kwa-ba.com: Next.js front end and Django API behind a single domain (no CORS between them).
# Template rendered by the nginx image at container start (envsubst, limited to R2_* variables): see compose.yml.

upstream kwaba_api    { server api:8000;    keepalive 16; }
upstream kwaba_client { server client:3000; keepalive 16; }

# The api and client names are resolved when the configuration loads: scripts/deploy.sh reloads nginx
# (nginx -s reload) after recreating those containers.

# Host photos are stored in R2 and served from https://kwa-ba.com/photos/: URLs saved in listings never depend
# on where the files live. File names are unique and never rewritten, so they can be cached for a long time.
proxy_cache_path /var/cache/nginx/photos levels=1:2 keys_zone=photos:10m max_size=2g inactive=30d use_temp_path=off;

# CSP reports: public address that ends up in the logs
limit_req_zone $binary_remote_addr zone=rapports_csp:1m rate=10r/m;

# Signature links: the token in the address gives access to the contract, it stays out of the logs. Same format as
# nginx's default one.
map $request_uri $uri_journal {
    "~^(?<avant>.*/(?:contrat|contrats/signature)/)[^/?]+(?<apres>.*)$" "$avant***$apres";
    default $request_uri;
}
map $http_referer $referer_journal {
    "~^(?<avant>.*/(?:contrat|contrats/signature)/)[^/?]+(?<apres>.*)$" "$avant***$apres";
    default $http_referer;
}
log_format journal '$remote_addr - $remote_user [$time_local] "$request_method $uri_journal $server_protocol" '
                   '$status $body_bytes_sent "$referer_journal" "$http_user_agent" "$http_x_forwarded_for"';

server_tokens off;
gzip on;
gzip_proxied any;
gzip_types application/json text/css application/javascript image/svg+xml;

# HTTP: Let's Encrypt challenge, otherwise redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name kwa-ba.com www.kwa-ba.com;
    access_log /var/log/nginx/access.log journal;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://kwa-ba.com$request_uri; }
}

# www.kwa-ba.com -> kwa-ba.com
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.kwa-ba.com;
    access_log /var/log/nginx/access.log journal;
    include /etc/nginx/snippets/tls.conf;
    return 301 https://kwa-ba.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name kwa-ba.com;
    access_log /var/log/nginx/access.log journal;
    include /etc/nginx/snippets/tls.conf;

    # Host photos: 10 MB max on the API side, plus some headroom for the multipart envelope
    client_max_body_size 12m;

    # A single HSTS header for the whole site (Django's is removed to avoid a duplicate). includeSubDomains: any subdomain
    # opened in a browser must be served in HTTPS. No "preload": see documentation/securite.md.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Auth.js (NextAuth) is served by the client under /api/auth/. "^~" makes it win over the /api/ regex
    # location below (otherwise nginx would send /api/auth/ to Django)
    location ^~ /api/auth/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://kwaba_client;
    }

    # API calls of the browser: the client relays them to Django with the session's token (client/src/app/api/proxy).
    # Direct calls to /api/ remain for what does not come from a browser (payment webhooks, health check).
    location ^~ /api/proxy/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://kwaba_client;
    }

    # Browsers' CSP violation reports (client/src/app/api/csp-report)
    location = /api/csp-report {
        limit_except POST { deny all; }
        limit_req zone=rapports_csp burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 32k;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://kwaba_client;
    }

    # Host photos, fetched from the public R2 bucket and cached locally (the r2.dev address is rate limited).
    # The R2 host is resolved when the configuration loads; the container is recreated at every deployment.
    location ^~ /photos/ {
        limit_except GET { deny all; }
        proxy_pass ${R2_PUBLIC_ORIGIN}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_cache photos;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 403 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Django API, admin and its static files (WhiteNoise)
    location ~ ^/(api|admin|static)/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_hide_header Strict-Transport-Security;
        proxy_pass http://kwaba_api;
    }

    # Everything else: the site (Next.js)
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://kwaba_client;
    }
}
