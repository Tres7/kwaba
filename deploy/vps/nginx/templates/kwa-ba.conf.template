# ${KWABA_DOMAIN} (kwa-ba.com in production): Next.js front end and Django API behind a single domain (no CORS between
# them). Templates rendered by the nginx image at container start (envsubst, limited to R2_* and KWABA_* variables):
# see compose.yml. This file holds what both TLS modes share; the servers come from the file of the mode:
#   KWABA_TLS_MODE=nginx (production)  kwa-ba-nginx.inc: nginx handles HTTPS (Let's Encrypt certificate)
#   KWABA_TLS_MODE=proxy (preprod)     kwa-ba-proxy.inc: plain HTTP behind the shared Caddy of the server, which does TLS
# Both include kwa-ba-site.inc, the body of the site. An unknown mode makes nginx -t fail (no such file).

upstream kwaba_api    { server api:8000;    keepalive 16; }
upstream kwaba_client { server client:3000; keepalive 16; }

# The api and client names are resolved when the configuration loads: scripts/deploy.sh reloads nginx
# (nginx -s reload) after recreating those containers.

# Host photos are stored in R2 and served from https://<domain>/photos/: URLs saved in listings never depend
# on where the files live. File names are unique and never rewritten, so they can be cached for a long time.
proxy_cache_path /var/cache/nginx/photos levels=1:2 keys_zone=photos:10m max_size=2g inactive=30d use_temp_path=off;

# CSP reports: public address that ends up in the logs
limit_req_zone $binary_remote_addr zone=rapports_csp:1m rate=10r/m;

# Signature links: the token in the address gives access to the contract, it stays out of the logs. Same format as
# nginx's default one.
map $request_uri $uri_journal {
    "~^(?<avant>.*/(?:contrat|contrats/signature)/)[^/?]+(?<apres>.*)$" "$avant***$apres";
    default $request_uri;
}
map $http_referer $referer_journal {
    "~^(?<avant>.*/(?:contrat|contrats/signature)/)[^/?]+(?<apres>.*)$" "$avant***$apres";
    default $http_referer;
}
log_format journal '$remote_addr - $remote_user [$time_local] "$request_method $uri_journal $server_protocol" '
                   '$status $body_bytes_sent "$referer_journal" "$http_user_agent" "$http_x_forwarded_for"';

server_tokens off;
gzip on;
gzip_proxied any;
gzip_types application/json text/css application/javascript image/svg+xml;

# Protocol seen by the visitor, sent to Django and Auth.js (snippets/proxy.conf): the one announced by the shared Caddy
# in proxy mode (the connection to nginx is plain HTTP there), the one of the connection otherwise.
map $http_x_forwarded_proto $kwaba_proto {
    default $scheme;
    https   https;
}

include /etc/nginx/conf.d/kwa-ba-${KWABA_TLS_MODE}.inc;
