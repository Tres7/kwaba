# KWABA_TLS_MODE=nginx (production): nginx handles HTTPS itself with the Let's Encrypt certificate of ${KWABA_DOMAIN}.

# HTTP: Let's Encrypt challenge, otherwise redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${KWABA_DOMAIN} www.${KWABA_DOMAIN};
    access_log /var/log/nginx/access.log journal;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${KWABA_DOMAIN}$request_uri; }
}

# www.<domain> -> <domain>
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${KWABA_DOMAIN};
    access_log /var/log/nginx/access.log journal;
    ssl_certificate /etc/letsencrypt/live/${KWABA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KWABA_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    return 301 https://${KWABA_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${KWABA_DOMAIN};
    access_log /var/log/nginx/access.log journal;
    ssl_certificate /etc/letsencrypt/live/${KWABA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KWABA_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    include /etc/nginx/conf.d/kwa-ba-site.inc;
}
