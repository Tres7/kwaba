# Copy to client.env on the VPS (chmod 600). Never commit it. Written by Ansible from the inventory (kwaba_env).
# Every value here is read when the container starts: the same client image serves the preprod and the production.

AUTH_SECRET=                  # openssl rand -base64 48
# Public address of the site: Auth.js, canonical links, link previews, sitemap
AUTH_URL=https://kwa-ba.com
# Google sign-in: OAuth client of the web application (same value as GOOGLE_CLIENT_ID in server.env)
GOOGLE_CLIENT_ID=
# Contact address shown on the site (info@kwa-ba.com if empty)
CONTACT_EMAIL=info@kwa-ba.com
