# Copy to backup.env on the VPS (chmod 600). Off-site copy of the database backups (a dedicated R2 bucket,
# separate from the photos one, with a key limited to that bucket). Empty: local backups only.
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT_URL=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# age public key (age1...): the copy on R2 is encrypted with it. Generate the key pair on your own computer,
# never on the VPS: "age-keygen -o kwaba-backups.key", keep that file in a password manager, put only the
# public key here. Without it, nothing is sent to R2.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=14
# Private files (volume prive-data), backed up every night only: kept for less time locally, they can be large
BACKUP_PRIVE_KEEP_DAYS=3
# Ping URL of a healthchecks.io check (https://hc-ping.com/<uuid>), period 1 day, grace 2 hours. Pinged after every
# backup, with /fail appended when it fails; a missing night also raises an alert. Empty: no monitoring.
BACKUP_HEALTHCHECK_URL=
