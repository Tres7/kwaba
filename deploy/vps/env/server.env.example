# Copy to server.env on the VPS (chmod 600). Never commit it.

DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
# kwa-ba.com: public (through nginx); api: client calls on the internal network; localhost: container healthcheck
DJANGO_ALLOWED_HOSTS=kwa-ba.com,api,localhost
# nginx already redirects public traffic to HTTPS; internal client calls (http://api:8000) must stay on HTTP
DJANGO_SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=https://kwa-ba.com
FRONTEND_URL=https://kwa-ba.com
BACKEND_URL=https://kwa-ba.com          # origin of the Django admin (links in team emails)

# Google sign-in: OAuth client ID of the web client (same value as the PUBLIC_GOOGLE_CLIENT_ID repository variable)
GOOGLE_CLIENT_ID=

# Emails (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kwa-Ba <info@kwa-ba.com>
EMAIL_REPLY_TO=info@kwa-ba.com

# Photos: Cloudflare R2
R2_BUCKET=
R2_ENDPOINT_URL=              # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Photos are served by nginx under https://kwa-ba.com/photos/ (proxied to the public R2 address, see nginx.env)
R2_PUBLIC_DOMAIN=kwa-ba.com/photos

# Pre-launch: listings hidden from the public, no booking, transfer, rental, donation or payment (True until the
# company is registered). Back to False: restart the API, verified listings become public.
PRELANCEMENT=True

# Payments
FEDAPAY_ENV=sandbox           # live for real production
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Concierge (Gemini)
GEMINI_API_KEY=

# Site settings (config/site.py): change, then restart the API — no code deployment needed.
# Modules hidden at launch (False): removed from menus, footer and sitemap, their URLs redirect to the home page.
MODULE_EXPERIENCES=False
MODULE_TOGETHER=False
MODULE_GIVE=False
MODULE_CONCIERGE=False          # hidden: no request is sent to Gemini
MODULE_LOCATION_SANS_CHAUFFEUR=False
MODULE_PAIEMENTS_NON_OUVERTS=False   # MTN, Orange Money, Celtiis, Airtel, PayPal
# Legal numbers and contact, shown as "to be completed" while empty
# (comments on their own line: on the line of an empty value, they would be read as the value)
SOCIETE_RCCM=
SOCIETE_NIF=
# E-commerce provider registration number (decree no. 2018-062/PR)
SOCIETE_COMMERCE_ELECTRONIQUE=
SOCIETE_IPDCP=
# Company being registered ("SAS en formation" on the site): False from the day of the RCCM
SOCIETE_EN_FORMATION=True
# Google Analytics measurement ID (G-…): empty, no audience measurement and no cookie banner
GOOGLE_ANALYTICS_ID=
