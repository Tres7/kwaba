{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "v1 : client déployé par Git (Vercel). v2 : client en image, comme le serveur (tout sur le VPS) ; clientPreprod (manifests de novembre 2026 seulement) : image client construite pour l'URL de la préprod, même révision que client ; depuis, une seule image client pour tous les environnements. Images sous tres7 (compte personnel, manifests antérieurs) ou kwa-ba (organisation).",
  "type": "object",
  "required": ["schemaVersion", "manifestVersion", "sourceRevision", "createdAt", "services"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "sourceRevision": { "$ref": "#/$defs/sha" },
    "createdAt": { "type": "string", "format": "date-time" },
    "services": {
      "type": "object",
      "required": ["server", "client"],
      "additionalProperties": false,
      "properties": {
        "server": { "$ref": "#/$defs/serverImage" },
        "client": { "type": "object" },
        "clientPreprod": { "$ref": "#/$defs/clientPreprodImage" }
      }
    }
  },
  "if": { "type": "object", "properties": { "schemaVersion": { "const": 1 } } },
  "then": { "type": "object", "properties": { "services": { "type": "object", "properties": { "client": { "$ref": "#/$defs/gitService" } } } } },
  "else": { "type": "object", "properties": { "services": { "type": "object", "properties": { "client": { "$ref": "#/$defs/clientImage" } } } } },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "serverImage": {
      "type": "object",
      "required": ["kind", "sourceRevision", "image"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "image" },
        "sourceRevision": { "$ref": "#/$defs/sha" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/(tres7|kwa-ba)/(afristay|kwaba)-server@sha256:[a-f0-9]{64}$" }
      }
    },
    "clientImage": {
      "type": "object",
      "required": ["kind", "sourceRevision", "image"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "image" },
        "sourceRevision": { "$ref": "#/$defs/sha" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/(tres7|kwa-ba)/(afristay|kwaba)-client@sha256:[a-f0-9]{64}$" }
      }
    },
    "clientPreprodImage": {
      "type": "object",
      "required": ["kind", "sourceRevision", "image"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "image" },
        "sourceRevision": { "$ref": "#/$defs/sha" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/(tres7|kwa-ba)/kwaba-client-preprod@sha256:[a-f0-9]{64}$" }
      }
    },
    "gitService": {
      "type": "object",
      "required": ["kind", "sourceRevision"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "git" },
        "sourceRevision": { "$ref": "#/$defs/sha" }
      }
    }
  }
}
