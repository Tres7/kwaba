# Auth.js
AUTH_SECRET=ta_cle_longue_aleatoire
# Public URL of the site (in production behind nginx: https://<domain>), used for the Auth.js URLs
AUTH_URL=http://localhost:3000

# APi
INTERNAL_API_URL=http://backend:8000/api
# NEXT_PUBLIC_*: baked into the browser code when the production image is built
# (GitHub repository variables PUBLIC_SITE_URL, PUBLIC_GOOGLE_CLIENT_ID, PUBLIC_CONTACT_EMAIL)
# Public address of the API: the browser goes through /api/proxy, this is the host of the absolute addresses of the API
NEXT_PUBLIC_API_URL=http://localhost:8000/api


NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Public address of the site (WhatsApp / Facebook link previews, absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
