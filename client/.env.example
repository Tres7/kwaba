# Auth.js
AUTH_SECRET=ta_cle_longue_aleatoire
# Public URL of the site (in production behind nginx: https://<domain>): Auth.js URLs, canonical and absolute links,
# link previews, sitemap. Read when the server starts, never at build time.
AUTH_URL=http://localhost:3000

# API
INTERNAL_API_URL=http://backend:8000/api
# Development only: the API is on its own port. In preprod and production it is served under the site (/api).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Google sign-in (OAuth client of the web application): empty, the Google button is hidden
GOOGLE_CLIENT_ID=your_google_client_id
# Contact address shown on the site (info@kwa-ba.com if empty)
CONTACT_EMAIL=
