# =========================
# Django
# =========================
# Required outside development: the server refuses to start without it when DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-django-secret-key
# Development only: the default value is False (production)
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
# Origins allowed to call the API (in production: the client's Vercel URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production only (ignored if DJANGO_DEBUG=True)
# DJANGO_SECURE_SSL_REDIRECT=True        # redirection HTTP -> HTTPS
# DJANGO_SECURE_HSTS_SECONDS=31536000    # HSTS header; 0 to disable it
# WEB_CONCURRENCY=2                      # nombre de workers Gunicorn
# Google sign-in: OAuth client ID of the web client (the same as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the client;
# several IDs possible, separated by commas). Empty: Google sign-in disabled.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile captcha (sign-in, sign-up). Empty: disabled.
# Test keys (always valid): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Delay (s) during which a renewed refresh token still returns the same pair (parallel NextAuth renewals)
JWT_REFRESH_GRACE_SECONDS=60
# JWT signing key (optional: otherwise derived from DJANGO_SECRET_KEY). Changing it signs everybody out.
# JWT_SIGNING_KEY=
# Number of trusted proxies in front of the API (Render: 1, and FORWARDED_ALLOW_IPS=* for Gunicorn; local: 0).
# Used to find the client's real IP address for the rate limits.
DJANGO_NUM_PROXIES=0
# Path of the Django administration (production: a hard-to-guess path, e.g. gestion-7f3k/)
# DJANGO_ADMIN_URL=admin/
# Emails that receive the production 500 errors (separated by commas)
# ADMINS=tech@kwa-ba.com
# Additional hosts allowed for images (avatars, listing photos), separated by commas
# IMAGES_HOTES=

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=kwaba
# Production: minimal-rights role kwaba_app (see deploy/postgres/roles.sql); the owner is used for migrations
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# =========================
# pgAdmin
# =========================
PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# =========================
# RabbitMQ
# =========================
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# =========================
# Email
# =========================
# Brevo (free plan: 300 emails/day). Brevo → SMTP & API → SMTP tab: login and SMTP key.
# Domain kwa-ba.com authenticated in Brevo (DKIM brevo1/brevo2, DMARC); locally without real sending:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kwa-Ba <noreply@kwa-ba.com>
SERVER_EMAIL=noreply@kwa-ba.com
EMAIL_TIMEOUT=20

# =========================
# Pre-launch: listings hidden from the public, no booking or payment (see config/prelancement.py)
# =========================
PRELANCEMENT=False

# =========================
# Paiement en ligne (FedaPay)
# =========================
# Without a secret key: payment disabled, bookings confirmed without collecting money.
# Keys: FedaPay dashboard → Settings → API keys (sk_sandbox_… for tests, sk_live_… in production)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
# FedaPay dashboard → Webhooks → webhook secret key. Required in production: without it, webhooks are
# refused (the payment status is then only read again when the traveller comes back and by the worker).
FEDAPAY_WEBHOOK_SECRET=
PAIEMENT_EXPIRATION_MINUTES=30

# PayPal (paiement en euros) : developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Payments worker: pause between two emails (free Mailtrap limits the rate) and public URL of the API
PAIEMENTS_PAUSE_EMAIL=0
BACKEND_URL=http://localhost:8000

# Support contact given to travellers (airport transfers) and reply-to address of emails
ASSISTANCE_CONTACT=info@kwa-ba.com
EMAIL_REPLY_TO=info@kwa-ba.com

# AI Concierge (Gemini): key on aistudio.google.com → Get API key, project with billing enabled
# (on the free plan, Google may use the conversations to improve its products). Empty = disabled.
GEMINI_API_KEY=
CONCIERGE_MODELE=gemini-3.8-flash
CONCIERGE_REFLEXION=low
CONCIERGE_RECHERCHE_WEB=True
CONCIERGE_MAX_PAR_HEURE=20
CONCIERGE_MAX_PAR_JOUR=60

# =========================
# Photo storage (Cloudflare R2)
# =========================
# Without R2_BUCKET: local disk (development). In production, R2 is essential:
# the disk of Render containers is wiped at every redeploy.
# R2_BUCKET=kwaba-photos
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=photos.example.com   # public domain of the bucket, without https://
# Private documents (hosts' identity documents, photos of verification visits): R2 bucket WITHOUT a public
# domain, same credentials. Without it: PRIVE_ROOT folder (server/prive/), lost at every redeploy of a
# container without a volume. See documentation/modules/verification.md
# R2_PRIVE_BUCKET=kwaba-prive
# PRIVE_ROOT=/app/prive

# =========================
# Site settings (config/site.py): change them then restart the API, without a code deployment
# =========================
# Modules hidden at launch (False): missing from the menus, the footer and the sitemap, addresses redirected
# to the home page. True to switch them back on.
MODULE_EXPERIENCES=False
MODULE_TOGETHER=False
MODULE_GIVE=False
MODULE_CONCIERGE=False          # hidden: no request to Gemini
MODULE_LOCATION_SANS_CHAUFFEUR=False
MODULE_PAIEMENTS_NON_OUVERTS=False   # MTN, Orange Money, Celtiis, Airtel, PayPal
# Legal numbers and contact, shown as "to be completed" while they are empty
# (comments on their own line: on the line of an empty value, they would be read as the value)
SOCIETE_RCCM=
SOCIETE_NIF=
# Registration number as an e-commerce service provider (decree no. 2018-062/PR)
SOCIETE_COMMERCE_ELECTRONIQUE=
SOCIETE_IPDCP=
# Company being registered ("SAS en formation" on the site): False from the day of the RCCM
SOCIETE_EN_FORMATION=True
# Google Analytics measurement ID (G-…): empty, no audience measurement and no cookie banner
GOOGLE_ANALYTICS_ID=
