# =========================
# Django
# =========================
# Obligatoire hors développement : le serveur refuse de démarrer sans elle quand DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-django-secret-key
# Développement uniquement : la valeur par défaut est False (production)
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
# Origines autorisées à appeler l'API (en production : l'URL Vercel du client)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production uniquement (ignorés si DJANGO_DEBUG=True)
# DJANGO_SECURE_SSL_REDIRECT=True        # redirection HTTP -> HTTPS
# DJANGO_SECURE_HSTS_SECONDS=31536000    # en-tête HSTS ; 0 pour le désactiver
# WEB_CONCURRENCY=2                      # nombre de workers Gunicorn
# Connexion Google : identifiant OAuth du client web (le même que NEXT_PUBLIC_GOOGLE_CLIENT_ID côté client ;
# plusieurs identifiants possibles, séparés par des virgules). Vide : connexion Google désactivée.
GOOGLE_CLIENT_ID=

# Captcha Cloudflare Turnstile (connexion, inscription). Vide : désactivé.
# Clés de test (toujours valides) : 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Délai (s) pendant lequel un refresh token renouvelé renvoie encore la même paire (renouvellements parallèles de NextAuth)
JWT_REFRESH_GRACE_SECONDS=60
# Clé de signature des JWT (optionnelle : à défaut, dérivée de DJANGO_SECRET_KEY). La changer déconnecte tout le monde.
# JWT_SIGNING_KEY=
# Nombre de proxys de confiance devant l'API (Render : 1, et FORWARDED_ALLOW_IPS=* pour Gunicorn ; local : 0).
# Sert à trouver l'adresse IP réelle du client pour les limites de débit.
DJANGO_NUM_PROXIES=0
# Chemin de l'administration Django (production : un chemin peu prévisible, ex. gestion-7f3k/)
# DJANGO_ADMIN_URL=admin/
# Emails qui reçoivent les erreurs 500 de production (séparés par des virgules)
# ADMINS=tech@kwa-ba.com
# Hôtes supplémentaires autorisés pour les images (avatars, photos d'annonces), séparés par des virgules
# IMAGES_HOTES=

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=kwaba
# Production : rôle à droits minimaux kwaba_app (voir deploy/postgres/roles.sql) ; le propriétaire sert aux migrations
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# =========================
# pgAdmin
# =========================
PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# =========================
# RabbitMQ
# =========================
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# =========================
# Email
# =========================
# Brevo (offre gratuite : 300 emails/jour). Brevo → SMTP & API → onglet SMTP : identifiant et clé SMTP.
# Domaine kwa-ba.com authentifié dans Brevo (DKIM brevo1/brevo2, DMARC) ; en local sans envoi réel :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kwa-Ba <noreply@kwa-ba.com>
SERVER_EMAIL=noreply@kwa-ba.com
EMAIL_TIMEOUT=20

# =========================
# Pre-launch: listings hidden from the public, no booking or payment (see config/prelancement.py)
# =========================
PRELANCEMENT=False

# =========================
# Paiement en ligne (FedaPay)
# =========================
# Sans clé secrète : paiement désactivé, réservations confirmées sans encaissement.
# Clés : tableau de bord FedaPay → Paramètres → Clés API (sk_sandbox_… en test, sk_live_… en production)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
# Tableau de bord FedaPay → Webhooks → clé secrète du webhook. Obligatoire en production : sans elle, les
# webhooks sont refusés (le statut des paiements est alors relu seulement au retour du voyageur et par le worker).
FEDAPAY_WEBHOOK_SECRET=
PAIEMENT_EXPIRATION_MINUTES=30

# PayPal (paiement en euros) : developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Worker des paiements : pause entre deux emails (Mailtrap gratuit limite le débit) et URL publique de l'API
PAIEMENTS_PAUSE_EMAIL=0
BACKEND_URL=http://localhost:8000

# Contact d'assistance donné aux voyageurs (transferts aéroport) et adresse de réponse des emails
ASSISTANCE_CONTACT=info@kwa-ba.com
EMAIL_REPLY_TO=info@kwa-ba.com

# AI Concierge (Gemini) : clé sur aistudio.google.com → Get API key, projet avec facturation activée
# (en offre gratuite, Google peut utiliser les conversations pour améliorer ses produits). Vide = désactivé.
GEMINI_API_KEY=
CONCIERGE_MODELE=gemini-3.8-flash
CONCIERGE_REFLEXION=low
CONCIERGE_RECHERCHE_WEB=True
CONCIERGE_MAX_PAR_HEURE=20
CONCIERGE_MAX_PAR_JOUR=60

# =========================
# Stockage des photos (Cloudflare R2)
# =========================
# Sans R2_BUCKET : disque local (développement). En production, R2 est indispensable :
# le disque des conteneurs Render est effacé à chaque redéploiement.
# R2_BUCKET=kwaba-photos
# R2_ENDPOINT_URL=https://<id-du-compte>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=photos.example.com   # domaine public du bucket, sans https://
# Documents privés (pièces d'identité des hôtes, photos des visites de vérification) : bucket R2 SANS domaine
# public, mêmes identifiants. Sans lui : dossier PRIVE_ROOT (server/prive/), perdu à chaque redéploiement d'un
# conteneur sans volume. Voir documentation/modules/verification.md
# R2_PRIVE_BUCKET=kwaba-prive
# PRIVE_ROOT=/app/prive

# =========================
# Réglages du site (config/site.py) : modifier puis redémarrer l'API, sans déploiement de code
# =========================
# Modules masqués au lancement (False) : absents des menus, du pied de page et du plan du site, adresses renvoyées
# vers l'accueil. True pour les rallumer.
MODULE_EXPERIENCES=False
MODULE_TOGETHER=False
MODULE_GIVE=False
MODULE_CONCIERGE=False          # masqué : aucune requête vers Gemini
MODULE_LOCATION_SANS_CHAUFFEUR=False
MODULE_PAIEMENTS_NON_OUVERTS=False   # MTN, Orange Money, Celtiis, Airtel, PayPal
# Numéros légaux et contact, affichés « à compléter » tant qu'ils sont vides
# (commentaires sur leur propre ligne : sur la ligne d'une valeur vide, ils seraient lus comme la valeur)
SOCIETE_RCCM=
SOCIETE_NIF=
# Numéro d'enregistrement de prestataire de commerce électronique (décret n° 2018-062/PR)
SOCIETE_COMMERCE_ELECTRONIQUE=
SOCIETE_IPDCP=
