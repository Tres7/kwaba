[importlinter]
root_package = apps

[importlinter:contract:modules-metier]
name = Les modules métier ne dépendent pas les uns des autres
type = independence
modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
ignore_imports =
    apps.** -> apps.*.api
    apps.backoffice.views -> apps.users.infrastructure.http.controllers.AuthController

[importlinter:contract:noyau-partage]
name = securite et notifications ne dépendent d'aucun module métier
type = forbidden
source_modules =
    apps.securite
    apps.notifications
forbidden_modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages

[importlinter:contract:emails]
name = Les emails passent par EmailRequestBus, pas par send_mail
type = forbidden
source_modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
forbidden_modules =
    apps.notifications.infrastructure.email
allow_indirect_imports = True
ignore_imports =
    apps.contrats.services -> apps.notifications.infrastructure.email.envoi
    apps.hebergements.lancement -> apps.notifications.infrastructure.email.envoi
    apps.paiements.notifications -> apps.notifications.infrastructure.email.envoi
    apps.users.infrastructure.messaging.FallbackEventBus -> apps.notifications.infrastructure.email.DjangoEmailSender
    apps.verifications.services -> apps.notifications.infrastructure.email.envoi
