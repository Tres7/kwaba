[importlinter]
root_package = apps

[importlinter:contract:modules-metier]
name = Les modules métier ne dépendent pas les uns des autres
type = independence
modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
ignore_imports =
    apps.** -> apps.*.api
    apps.avis.models -> apps.hebergements.models
    apps.avis.models -> apps.reservations.models
    apps.avis.serializers -> apps.reservations.models
    apps.avis.services -> apps.hebergements.models
    apps.avis.services -> apps.reservations.models
    apps.avis.views -> apps.hebergements.models
    apps.avis.views -> apps.hebergements.serializers
    apps.backoffice.give -> apps.give.models
