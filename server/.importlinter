[importlinter]
root_package = apps

[importlinter:contract:modules-metier]
name = Les modules métier ne dépendent pas les uns des autres
type = independence
modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
ignore_imports =
    apps.** -> apps.*.api
    apps.backoffice.give -> apps.give.models
    apps.backoffice.give -> apps.give.services
    apps.backoffice.locations -> apps.locations.models
    apps.backoffice.locations -> apps.locations.services
    apps.backoffice.locations -> apps.paiements.operateurs
    apps.backoffice.transferts -> apps.paiements.operateurs
    apps.backoffice.transferts -> apps.transferts.models
    apps.backoffice.transferts -> apps.transferts.services
    apps.backoffice.urls -> apps.hebergements.lancement
    apps.backoffice.views -> apps.avis.models
    apps.backoffice.views -> apps.hebergements.archivage
    apps.backoffice.views -> apps.hebergements.models
    apps.backoffice.views -> apps.paiements.models
    apps.backoffice.views -> apps.paiements.services
    apps.backoffice.views -> apps.paiements.tarifs
    apps.backoffice.views -> apps.reservations.models
    apps.backoffice.views -> apps.users.infrastructure.http.controllers.AuthController
    apps.paiements.relances -> apps.locations.models
    apps.paiements.relances -> apps.reservations.models
    apps.paiements.relances -> apps.transferts.models
    apps.paiements.services -> apps.give.services
    apps.paiements.services -> apps.hebergements.alertes
    apps.paiements.services -> apps.hebergements.disponibilites
    apps.paiements.services -> apps.locations.models
    apps.paiements.services -> apps.locations.services
    apps.paiements.services -> apps.reservations.models
    apps.paiements.services -> apps.transferts.models
    apps.paiements.services -> apps.transferts.services
    apps.paiements.tarifs -> apps.reservations.models
    apps.paiements.views -> apps.reservations.models

[importlinter:contract:noyau-partage]
name = securite et notifications ne dépendent d'aucun module métier
type = forbidden
source_modules =
    apps.securite
    apps.notifications
forbidden_modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages

[importlinter:contract:emails]
name = Les emails passent par EmailRequestBus, pas par send_mail
type = forbidden
source_modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
forbidden_modules =
    apps.notifications.infrastructure.email
allow_indirect_imports = True
ignore_imports =
    apps.contrats.services -> apps.notifications.infrastructure.email.envoi
    apps.hebergements.lancement -> apps.notifications.infrastructure.email.envoi
    apps.paiements.notifications -> apps.notifications.infrastructure.email.envoi
    apps.users.infrastructure.messaging.FallbackEventBus -> apps.notifications.infrastructure.email.DjangoEmailSender
    apps.verifications.services -> apps.notifications.infrastructure.email.envoi
