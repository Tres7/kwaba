[importlinter]
root_package = apps

[importlinter:contract:modules-metier]
name = Les modules métier ne dépendent pas les uns des autres
type = independence
modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
ignore_imports =
    apps.** -> apps.*.api

[importlinter:contract:noyau-partage]
name = securite et notifications ne dépendent d'aucun module métier
type = forbidden
source_modules =
    apps.securite
    apps.notifications
forbidden_modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages

[importlinter:contract:emails]
name = Les emails passent par apps.notifications.api
type = forbidden
source_modules =
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
forbidden_modules =
    apps.notifications.application
    apps.notifications.infrastructure
    apps.notifications.management
allow_indirect_imports = True
